# Environment Variables for KrishiMitra (SmartKissan)

# Node Version
NODE_VERSION=22

# OpenWeatherMap API Key for hyper-local weather & farm forecasts
EXPO_PUBLIC_WEATHER_API_KEY=your_weather_api_key_here

# Google Gemini API Key for multimodal crop disease detection
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key for high-speed online AI reasoning (LLaMA / Qwen / GPT-OSS)
EXPO_PUBLIC_GROQ_API_KEY=your_groq_api_key_here
